# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase Postgres)
# DATABASE_URL: transaction pooler URL (usually port 6543). For serverless deployments,
# keep connection_limit low (typically 1 per app instance) and budget for all instances.
# For local development with a single app process, connection_limit=5 can improve concurrency.
DATABASE_URL=
# DIRECT_URL: direct database URL (usually port 5432), used by Prisma migrations.
DIRECT_URL=

# Auth.js
NEXTAUTH_SECRET=replace-with-32-byte-random-secret
NEXTAUTH_URL=http://localhost:3000

# Flutterwave
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
NEXT_PUBLIC_FLW_PUBLIC_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (email)
RESEND_API_KEY=

# Site Configuration
NEXT_PUBLIC_SITE_NAME=Supalovefoods
NEXT_PUBLIC_TAGLINE=Export · Wholesale · Retail
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=

# Admin Credentials (for admin dashboard login; prefer a bcrypt ADMIN_PASSWORD_HASH in production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
